# Launch defaults for a 4-GPU EPYC host.
# Peer access across every card, and the optimized serving path on.
DSV41_P2P=all
NCCL_P2P_DISABLE=0
NCCL_P2P_LEVEL=SYS
DSV41_R2=1
DSV41_R2_PAD7=1
W26_ATTENTION_BANK=1
W26_ATTENTION_SPLIT=1
W26_SAMPLER_BANK=1
W14_COLLECTIVE_PROFILES=1
W15_PAIR_TRANSPORT=1
W26_DSPARK_CAPTURE_LOCAL=0
W26_MHC_DUAL_GRAPH=0
